        {
          "selector": ".hero-device-rescue",
          "property": "width",
          "includes": "min("
        },
        {
          "selector": ".hero-note",
          "property": "top",
          "minimumPx": 18
        },
        {
          "selector": ".watch-preview",
          "property": "bottom",
          "minimumPx": 18
        },
        {
          "selector": ".rescue-grid",
