  "layoutChecks": [
    {
      "name": "homepage hero overlap guard",
      "path": "styles.css",
      "rules": [
        {
          "selector": ".hero-layout",
          "property": "min-height",
          "minimumPx": 620
        },
        {
          "selector": ".hero-stage",
          "property": "min-height",
